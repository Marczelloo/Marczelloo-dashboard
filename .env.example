# Marczelloo Dashboard Environment Configuration
# Copy this to .env.local and fill in your values

# ========================================
# AtlasHub Configuration (REQUIRED)
# ========================================
ATLASHUB_API_URL=http://localhost:3001
ATLASHUB_SECRET_KEY=sk_your_secret_key_here

# ========================================
# Authentication
# ========================================
# Comma-separated list of allowed Cloudflare Access emails
OWNER_EMAILS=admin@example.com

# PIN hash (generate with: node -e "require('bcryptjs').hash('your-pin', 10).then(console.log)")
# Keep the bcrypt hash in single quotes, otherwise Compose expands the $ signs:
# PIN_HASH='$2a$10$...'
PIN_HASH='$2a$10$...'

# Session secret for signing cookies (generate with: openssl rand -base64 32)
SESSION_SECRET=your-session-secret-here

# Cloudflare Access (required in production)
# Team domain: Zero Trust → Settings → Custom pages → Team domain
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# Application Audience (AUD) Tag: Zero Trust → Access → Applications → dashboard → Overview
CF_ACCESS_AUD=your-aud-tag

# ========================================
# Development Mode (DO NOT USE IN PRODUCTION)
# ========================================
# DEV_USER_EMAIL and DEV_SKIP_PIN are ignored when NODE_ENV=production.
# Skip Cloudflare Access email check (use this email instead)
# DEV_USER_EMAIL=dev@example.com

# Skip PIN verification for all operations
# DEV_SKIP_PIN=true

# ========================================
# Demo Mode (for portfolio/showcase)
# ========================================
# Enable demo mode with mock data and disabled destructive actions
# DEMO_MODE=true

# ========================================
# Encryption (for env vars at rest)
# ========================================
# 32-byte base64 encoded key (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=your-32-byte-base64-encoded-key

# ========================================
# Portainer Configuration
# ========================================
PORTAINER_URL=http://localhost:9000
PORTAINER_TOKEN=ptr_your_portainer_token
PORTAINER_USERNAME=admin
PORTAINER_PASSWORD=your_portainer_password
# Encrypted fallback path used when AtlasHub's settings table is unavailable
PORTAINER_TOKEN_FILE=.data/portainer-token.json

# ========================================
# Deploy agent (stage 2)
# ========================================
# Shared with agent/.env; generate with: openssl rand -hex 32
AGENT_TOKEN=
# AGENT_URL=http://mz-agent:8790

# Directory with project checkouts on the Pi (the agent mounts it at the same path)
PROJECTS_DIR=/home/Marczelloo_pi/projects

# ========================================
# Cloudflare Tunnel deployment integration (optional)
# ========================================

# Cloudflare-managed tunnel (stage 3). When all three are set the dashboard
# edits routes and DNS through the API instead of the cloudflared file below.
# Token permissions: Account › Cloudflare Tunnel: Edit, Zone › DNS: Edit, Zone › Zone: Read.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_ID=
# CNAMEs pointing at these old tunnels are moved to CLOUDFLARE_TUNNEL_ID when a route is saved.
# CLOUDFLARE_LEGACY_TUNNEL_IDS=

# Enables the "Cloudflare Tunnel" exposure option in Deploy from GitHub.
CLOUDFLARED_CONFIG_PATH=/etc/cloudflared/config.yml
# Set to true when the system cloudflared service owns the config file.
CLOUDFLARED_CONFIG_USE_SUDO=true
# Use the command appropriate for the current cloudflared installation.
CLOUDFLARED_RELOAD_COMMAND=sudo -n systemctl restart cloudflared
# Optional: creates the DNS route when the cloudflared host has credentials.
# CLOUDFLARED_TUNNEL_NAME=your-tunnel-name

# ========================================
# Notifications
# ========================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# SMTP (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@example.com

# ========================================
# GitHub App Integration
# ========================================
# GitHub App ID (from app settings page)
GITHUB_APP_ID=123456

# GitHub App Private Key (base64 encoded)
# Generate with: cat private-key.pem | base64 -w 0
GITHUB_PRIVATE_KEY_BASE64=LS0tLS1CRUdJTi...

# GitHub App Installation ID (from installations page or webhook)
GITHUB_INSTALLATION_ID=12345678

# Webhook secret for verifying GitHub webhook payloads
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here


# ========================================
# Application Settings
# ========================================
# Base URL of the application (for webhooks, notifications)
APP_URL=https://dashboard.yourdomain.com

# PIN session TTL in seconds (default: 30 minutes)
PIN_SESSION_TTL=1800

# Days of uptime check history to keep (default 30)
UPTIME_RETENTION_DAYS=30

# Monitoring cycle (min 30000) and days of resolved incidents to keep
MONITORING_INTERVAL_MS=60000
MONITOR_INCIDENT_RETENTION_DAYS=90
